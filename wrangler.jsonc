{
  "name": "anhtrong-jft-app",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "keep_vars": true,
  "workers_dev": true,
  "durable_objects": { "bindings": [ { "name": "KT", "class_name": "KiemTra" } ] },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": [ "KiemTra" ] } ]
}
